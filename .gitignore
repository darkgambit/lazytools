# ---- personal data — NEVER commit ----
INFO.md

# ---- local agent workspace / memory — must not be deployed publicly ----
.workbuddy-ai/
.claude/

# ---- OS cruft ----
.DS_Store
Thumbs.db
desktop.ini

# ---- dependencies / build output ----
node_modules/
.wrangler/
.netlify/
__pycache__/
*.pyc

# ---- git internals ----
# filter-branch scratch. It lands at the repo root, is never wanted in a commit, and the
# sandbox's bulk-delete guard can refuse to remove it — so ignore it rather than fight it.
.git-rewrite/

# ---- editor ----
.vscode/
.idea/
*.swp
